# Copy to .env and fill in the values. .env is gitignored — never commit real
# secrets. Docker compose interpolates these; local pocketbase.exe runs use
# src/apps/pocketbase/.env instead (see src/apps/pocketbase/start.sh).

# ── Existing variables (mirrors the current .env) ───────────────────────────
PB_URL=
PB_EMAIL=
PB_PASSWORD=

# Docker compose also interpolates these (docker-compose.yml /
# docker-compose.dev.yml). Uncomment and fill in for docker runs.
# PB_ADMIN_EMAIL=webmaster@fenrirclub.be
# PB_ADMIN_PASSWORD=change-me

# ── DeepL auto-translation (pb_hooks/translate.pb.js) ───────────────────────
DEEPL_API_KEY=

# ── GitHub issue hook (pb_hooks/forms.pb.js, hook "bugticket") ──────────────
# A fine-grained PAT with "Issues: Read and write" on WebmasterFenrir/
# FenrirWebsite (or a classic PAT with the issues scope).
GITHUB_TOKEN=
GITHUB_REPO=WebmasterFenrir/FenrirWebsite
