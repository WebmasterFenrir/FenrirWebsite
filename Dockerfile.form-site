# Stage 1: Build
FROM oven/bun:latest AS builder
WORKDIR /app

COPY ./src .
RUN bun install

# Build all workspaces (turbo skips apps without a build script)
RUN bun run build

# Stage 2: Serve
FROM node:lts-alpine
WORKDIR /app

COPY --from=builder /app/apps/form-site/dist ./dist
COPY --from=builder /app/apps/form-site/package.json ./package.json
RUN npm install --omit=dev --ignore-scripts

ENV HOST=0.0.0.0
ENV PORT=4321
EXPOSE 4321

CMD ["node", "./dist/server/entry.mjs"]
