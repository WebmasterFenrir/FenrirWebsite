---
import '../styles/global.css';

const { title } = Astro.props;
---

<html lang="nl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/schild.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Gabarito:wght@400..900&display=swap"
			rel="stylesheet"
		/>
		<meta name="robots" content="noindex, nofollow" />
		<title>{title ?? 'Fenrir'}</title>
	</head>
	<body class="min-h-dvh bg-background text-foreground antialiased">
		<slot />
	</body>
</html>
