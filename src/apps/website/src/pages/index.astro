---
import '../styles/global.css';
import { Button } from '../components/ui/button';
import MainLayout from '@/layouts/main.astro';
import ContextLayout from '@/layouts/context.astro'
import SponsorList from '@/components/SponsorList';
import SectionHeader from '@/components/ui/sectionHeader';
import PreasidiumPrevieuwHomePage from '@/components/PreasidiumPrevieuwHomePage';
import Spacer from '@/components/ui/spacer';
import { IconCard } from '@/components/IconCard';
import { getSponsors, getPreasidiumYears } from '@/lib/pocketbase';
import { Users, Calendar, MapPin, HeartHandshake } from 'lucide-react';

const [sponsors, years] = await Promise.all([getSponsors(), getPreasidiumYears()]);
const previewLeden = years[0]?.PreasidiumLeden.slice(0, 2) ?? [];

const activityTeasers = [
  { emoji: "🎉", title: "Feestjes & TD's", description: "In Den Echo en samen met andere Antwerpse clubs." },
  { emoji: "🎵", title: "Cantussen", description: "Zingen, drinken en ons clublied voluit meebrullen." },
  { emoji: "🏀", title: "Sport", description: "Voetbal- en basketbaltoernooien in Wilrijk." },
  { emoji: "🍿", title: "Cultuur", description: "Filmavonden, jeneverwandelingen en nog meer." },
];
---
<style>
	.hero {
		background: linear-gradient(rgba(93,63,211,0.6), rgb(12, 10, 9)), url('../../images/hero.jpg') center/cover no-repeat;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-title {
		opacity: 0;
		animation: fadeInUp 0.7s ease-out forwards;
	}

	.hero-subtitle {
		opacity: 0;
		animation: fadeInUp 0.7s ease-out 0.15s forwards;
	}

	.hero-cta {
		opacity: 0;
		animation: fadeInUp 0.7s ease-out 0.3s forwards;
	}

	@keyframes heroBtnShake {
		/* shake happens in the first ~15%, rest is a pause */
		0%        { transform: rotate(0deg); }
		2%        { transform: rotate(-4deg); }
		4%        { transform: rotate(4deg); }
		6%        { transform: rotate(-3deg); }
		8%        { transform: rotate(3deg); }
		10%       { transform: rotate(-1deg); }
		12%       { transform: rotate(1deg); }
		14%, 100% { transform: rotate(0deg); }
	}

	.hero-btn {
		transition: transform 0.18s ease, box-shadow 0.18s ease !important;
		animation: heroBtnShake 4s ease-in-out 1.8s infinite;
	}

	.hero-btn:hover {
		transform: translateY(-3px) scale(1.04);
		box-shadow: 0 8px 32px oklch(0.627 0.265 303.9 / 0.55);
		animation-play-state: paused;
	}

	.hero-btn:active {
		transform: translateY(0) scale(0.97);
		box-shadow: 0 2px 8px oklch(0.627 0.265 303.9 / 0.3);
	}
</style>
<MainLayout title="Fenrir Antwerpen">
		<div class="grid place-items-center h-screen content-center hero">
			<h1 class="hero-title text-4xl sm:text-6xl lg:text-8xl text-white font-bold">Fenrir Antwerpen</h1>
			<h2 class="hero-subtitle text-lg sm:text-2xl lg:text-4xl mt-5 text-white font-medium">De vriendelijkste club van Antwerpen!</h2>
			<span class="hero-cta flex flex-col sm:flex-row w-3/6 sm:w-max gap-3 sm:gap-4 mt-4">
				<a href="https://docs.google.com/forms/d/e/1FAIpQLSdaEL-QgBllK1SMC0Ckwrr98dDxFbch5TijesD71YsS8t5g4g/viewform?usp=sharing&ouid=100528290258116040611"><Button variant="default" className='hero-btn w-full sm:w-auto p-6 sm:p-6 lg:p-8 text-2xl lg:text-4xl'>Word lid!</Button></a>
				<a href="/activiteiten"><Button variant="secondary" className='w-full sm:w-auto p-6 sm:p-6 lg:p-8 text-2xl lg:text-4xl'>Bekijk activiteiten</Button></a>
			</span>
		</div>
		<ContextLayout>
<div class="mx-auto px-6 sm:px-8 py-10">
    <div class="flex flex-col md:flex-row md:items-stretch gap-6" id="welcomesection">

        <img
            src="../../images/schild.png"
            alt="Fenrir schild"
            class="
                h-40 md:h-full
                w-auto
                object-contain
                shrink-0
                self-center md:self-auto
            "
        >

			<div class="flex content-center place-items-center">
       			<div class="text-center md:text-left">
					<h1 class="font-bold text-4xl mb-4 text-accent">Bij Fenrir zit je goed!</h1>	
					<h2 class="font-medium text-2xl mb-4">De studentenclub waar vriendschap en gezelligheid voorop staan. Klein van omvang, maar groot in sfeer en saamhorigheid.</h2>
					<p class="mb-4">Wij zijn studentenvereniging Fenrir, een toffe gezellige vereniging verbonden aan Karel de Grote hogeschool. We nemen je mee in het Antwerps studentleven. Ontmoet vrienden voor het leven, maak de gekste avonturen mee, ontdek Antwerpen en geniet van het studentenleven. </p>
					<p class="mb-4">Wekelijks organiseren we verschillende activiteiten zoals onder andere feestjes, cultuuractiviteiten en sport.</p>
						<p class="mb-4">Kom erbij en geniet van je studentenleven! Dansen, lachen, brullen, gieren,… dat beleef je met Fenrir!</p>
				</div>
			</div>
			</div>

	<Spacer/>

	<SectionHeader title='Waarom Fenrir' description='Studentenleven draait om meer dan alleen studeren. Bij Fenrir vind je vrienden, ontdek je de stad en beleef je samen onvergetelijke momenten.'/>

	<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-8">
		<IconCard
			icon={Users}
			title="hechte vriendengroep"
			description="Je bent nooit alleen. Samen met andere studenten maken we er elke activiteit een gezellige tijd van."
			variant="subtle"
		/>
		<IconCard
			icon={Calendar}
			title="Activiteiten het hele jaar"
			description="Van feestjes en cantussen tot sport en cultuur: er is altijd iets om naar uit te kijken."
			variant="subtle"
		/>
		<IconCard
			icon={MapPin}
			title="Antwerpen ontdekken"
			description="We leren je de leukste plekken van de stad kennen, van goedkope eettentjes tot de beste uitgaansgelegenheden."
			variant="subtle"
		/>
		<IconCard
			icon={HeartHandshake}
			title="Iedereen is welkom"
			description="Je studierichting maakt niet uit. Bij Fenrir is plezier en respect belangrijker dan waar je vandaan komt."
			variant="subtle"
		/>
	</div>

	<Spacer/>

	<!-- <SectionHeader title='Ontdek onze activiteiten' description='Van feestjes en cantussen tot sport en cultuur: er is voor elk wat wils. Bekijk wat we organiseren en kom gerust eens meedoen.'/>

	<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-8">
		{activityTeasers.map((activity) => (
			<div class="bg-card border border-zinc-800 rounded-xl p-6 text-center transition-all duration-300 hover:border-purple-500/30 hover:bg-zinc-900/80">
