				<h3 class="text-lg font-bold text-white mb-2">{activity.title}</h3>
				<p class="text-zinc-400 text-sm">{activity.description}</p>
			</div>
		))}
	</div>

	<div class="flex justify-center mb-8">
		<a href="/activiteiten">
			<Button variant="secondary" className="p-6 text-lg">Alle activiteiten bekijken</Button>
		
		</a>
	</div> -->

	<Spacer/>

	<SectionHeader title='Huidig Praesidium' description='Het praesidium is het kloppend hart van Fenrir dat elk evenement zijn best doet om er weer een geweldige tijd van te maken.'/>
	<div>
		<PreasidiumPrevieuwHomePage leden={previewLeden} client:load/>
	</div>
	<Spacer/>
    <SectionHeader title='Onze Sponsors' description='Dankzij deze partners kunnen we onze werking verder uitbouwen en onze studenten blijven ondersteunen.'/>
    <div class="w-full">
        <SponsorList data={sponsors}/>
    </div>

		</ContextLayout>
</MainLayout>