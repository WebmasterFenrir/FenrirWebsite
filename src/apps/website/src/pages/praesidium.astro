---
import MainLayout from '@/layouts/main.astro';
import ContextLayout from '@/layouts/context.astro'
import PreasidiumList from '@/components/PreasidiumList';
import Spacer from '@/components/ui/spacer';
import SectionHeader from '@/components/ui/sectionHeader';
---
<MainLayout title="Praesidium">
  <div class="grid place-items-center mt-30 md:mt-0 md:h-[50vh] content-center">
    <div class="text-center px-6">
      <h1 class="text-6xl md:text-8xl text-white font-bold">Het Praesidium</h1>
      <h2 class="text-base sm:text-xl lg:text-2xl mt-4 text-white/90 font-medium max-w-3xl">
        Het praesidium is het kloppend hart van Fenrir. Een team van gemotiveerde studenten
        dat activiteiten organiseert, nieuwe leden onthaalt en zorgt dat onze club blijft draaien.
      </h2>
    </div>
  </div>
  <ContextLayout>
    <div class="mx-auto px-6 sm:px-8 py-12 w-full">
      <SectionHeader
        title="Wat Doet Het Praesidium"
        description="Van planning tot promotie en van cantussen tot sport en cultuur: elk lid heeft een eigen rol en verantwoordelijkheid. Samen zorgen ze voor een warm welkom, een goed gevulde kalender en onvergetelijke momenten."
      />
        <div class="grid gap-6 text-zinc-200">
          <p>
            Het praesidium bestaat uit verschillende functies zoals praeses, vice-praeses,
            quaestor, ab-actis, cantor, feest, media, sport, schachtenmeester/-temmer,
            cultuur & ontspanning, mentor/meter/peter ... Elke functie draagt bij aan
            de werking van onze vereniging.
          </p>
          <ul class="grid sm:grid-cols-2 gap-4 text-sm md:text-base">
            <li class="bg-zinc-900/50 border border-zinc-800 rounded-lg p-4">
              Praeses & Vice-Praeses: leiden het team en bewaken de visie.
            </li>
            <li class="bg-zinc-900/50 border border-zinc-800 rounded-lg p-4">
              Quaestor & Ab-Actis: financien en administratie op orde.
            </li>
            <li class="bg-zinc-900/50 border border-zinc-800 rounded-lg p-4">
              Cantor & Feest: zorgen voor sfeer, cantus en events.
            </li>
            <li class="bg-zinc-900/50 border border-zinc-800 rounded-lg p-4">
              Media & PR: communicatie, socials en promotie.
            </li>
            <li class="bg-zinc-900/50 border border-zinc-800 rounded-lg p-4">
              Sport & Cultuur: activiteiten voor elk wat wils.
            </li>
            <li class="bg-zinc-900/50 border border-zinc-800 rounded-lg p-4">
              Schachtenwerking: onthaalt nieuwe leden met respect en fun.
            </li>
          </ul>
          <p>
            Heb je vragen of wil je mee het verschil maken? Spreek iemand van het
            praesidium aan tijdens een activiteit of stuur ons een berichtje via onze kanalen.
          </p>
        </div>

      <Spacer />
      <SectionHeader
        title="Praesidium Per Jaar"
        description="Bekijk wie er de voorbije jaren mee de schouders onder Fenrir zette."
      />
      <PreasidiumList client:load />
    </div>
  </ContextLayout>
</MainLayout>
