---
import { defaultLang, useTranslations, type Locale } from "@/i18n/ui";

interface Props {
  secondaryText?: string;
  rights?: string;
}

const { secondaryText, rights } = Astro.props as Props;

const lang: Locale = (Astro.currentLocale as Locale) ?? defaultLang;
const t = useTranslations(lang);
---

<div class="relative border-t border-purple-500/10 px-6 py-6 text-xs text-zinc-500">
  <div class="mx-auto flex max-w-6xl flex-col gap-2 text-center uppercase tracking-[0.3em] sm:flex-row sm:items-center sm:justify-between sm:text-left">
    <span>&copy; {new Date().getFullYear()} Fenrir Club. {rights ?? t("footer.rights")}</span>
    <span class="text-zinc-600">{secondaryText ?? t("footer.builtBy")}</span>
  </div>
</div>
