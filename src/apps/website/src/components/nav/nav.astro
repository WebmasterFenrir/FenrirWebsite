---
import { getRelativeLocaleUrl } from "astro:i18n";
import HamburgerMenu from "./HamburgerMenu";
import LanguageSwitcher from "../LanguageSwitcher.astro";
import { defaultLang, useTranslations, type Locale, type UiKey } from "@/i18n/ui";
import { localizePathname } from "@/i18n/utils";

const lang: Locale = (Astro.currentLocale as Locale) ?? defaultLang;
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;

const navItems: { url: string; label: string; active: boolean }[] = [
  { slug: "", labelKey: "nav.home" },
  { slug: "activiteiten", labelKey: "nav.activiteiten" },
  { slug: "over-ons", labelKey: "nav.over-ons" },
  { slug: "praesidium", labelKey: "nav.praesidium" },
  { slug: "sponsors", labelKey: "nav.sponsors" },
].map((item) => ({
  url: getRelativeLocaleUrl(lang, item.slug),
  label: t(item.labelKey as UiKey),
  // The localized home URL is "/" (or "/en/"), so exact-match it; every other
  // page matches by prefix so /praesidium/2024-style subpaths stay lit too.
  active:
    item.slug === ""
      ? currentPath === getRelativeLocaleUrl(lang, "")
      : currentPath.startsWith(getRelativeLocaleUrl(lang, item.slug)),
}));

// Language options for the mobile menu (plain data, serializable to the island)
const languageLinks = (["nl", "en"] as const).map((locale) => ({
  label: locale.toUpperCase(),
  // ?lang= lets the middleware persist the explicit choice in a cookie.
  href: `${localizePathname(currentPath, locale)}?lang=${locale}`,
  active: locale === lang,
}));
---

<nav aria-label="Hoofdnavigatie" class="fixed top-0 inset-x-0 z-50 flex flex-row-reverse sm:flex-row">
  <!-- Glass bar: translucent card surface + blur so it stays readable over the
       hero and content, with a hairline bottom edge. The pill around the active
       page gives a persistent 'where am I' cue the old corner blob lacked. -->
  <div class="hidden sm:flex items-center gap-1 px-3 py-2 rounded-br-2xl border-b border-border/60 bg-card/70 backdrop-blur-md shadow-sm w-max">
    {navItems.map((page) => (
      <a
        href={page.url}
        aria-current={page.active ? "page" : undefined}
        class:list={[
          "rounded-lg px-3 py-1.5 text-sm font-medium transition-colors duration-200",
          page.active
            ? "bg-primary/15 text-primary-foreground"
            : "text-muted-foreground hover:bg-white/5 hover:text-foreground",
        ]}
      >
        {page.label}
      </a>
    ))}
    <LanguageSwitcher lang={lang} />
  </div>

  <div class="sm:hidden px-3 py-2 rounded-bl-2xl sm:rounded-br-2xl border-b border-border/60 bg-card/70 backdrop-blur-md shadow-sm w-max">
    <HamburgerMenu
      links={navItems}
      menuTitle={t("nav.menuTitle")}
      menuDescription={t("nav.menuDescription")}
      languageLabel={t("nav.language")}
      languageLinks={languageLinks}
      client:load
    />
  </div>
</nav>
