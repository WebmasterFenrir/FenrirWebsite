---
import { Menu } from "lucide-react";
import { Button } from "../ui/button";
import HamburgerMenu from "./HamburgerMenu"
const pages = await Astro.glob("../../pages/**/*.astro");

// Normalize route + label
const navItems = pages
  // optional: filter out special files
  .filter((p) => !p.file.endsWith("404.astro"))
  .map((p) => {
    const url = p.url ?? p.file
      .replace(/^.*\/pages/, "")
      .replace(/index\.astro$/, "")
      .replace(/\.astro$/, "");

    const segment = url.split("/").filter(Boolean)[0] ?? "";
    const label = segment
      ? segment.replace(/-/g, " ")
      : "Home";

    return { url: url || "/", label };
  });
---

<nav aria-label="Hoofdnavigatie" class="fixed top-0 inset-x-0 z-50 flex flex-row-reverse sm:flex-row">
  <div class="hidden sm:flex p-2 rounded-br-2xl gap-2 bg-card w-max">
    {navItems.map((page) => (
      <a href={page.url}>
        <Button variant="link">{page.label.charAt(0).toUpperCase() + page.label.slice(1)}</Button>
      </a>
    ))}
  </div>
  
    <div class="sm:hidden p-2 rounded-bl-2xl sm:rounded-br-2xl gap-2 bg-card w-max">
      <HamburgerMenu links={pages} client:load/>
    <!-- {navItems.map((page) => (
      <a href={page.url}>
        <Button variant="link">{page.label.charAt(0).toUpperCase() + page.label.slice(1)}</Button>
      </a>
    ))} -->
  </div>
</nav>