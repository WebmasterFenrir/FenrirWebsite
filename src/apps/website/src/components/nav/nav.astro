---
import { Button } from "../ui/button";
const pages = await Astro.glob("../../pages/**/*.astro");

// Normalize route + label
const navItems = pages
  // optional: filter out special files
  .filter((p) => !p.file.endsWith("404.astro"))
  .map((p) => {
    const url = p.url ?? p.file
      .replace(/^.*\/pages/, "")
      .replace(/index\.astro$/, "")
      .replace(/\.astro$/, "");

    const segment = url.split("/").filter(Boolean)[0] ?? "";
    const label = segment
      ? segment.replace(/-/g, " ")
      : "Home";

    return { url: url || "/", label };
  });
---

<nav class="fixed top-0 inset-x-0 z-50">
  <div class="flex p-4 gap-2">
    {navItems.map((page) => (
      <a href={page.url}>
        <Button variant="ghost">{page.label}</Button>
      </a>
    ))}
  </div>
</nav>