---
import MainLayout from '@/layouts/main.astro';
import ContextLayout from '@/layouts/context.astro';
import SectionHeader from '@/components/ui/sectionHeader';
import Spacer from '@/components/ui/spacer';
import { Button } from '@/components/ui/button';
import { getActiviteiten, getEventCategories } from '@/lib/pocketbase';
import EventGrid from '@/components/EventGrid.astro';
import { IconCard } from '@/components/IconCard';
import {
  PartyPopper,
  Music,
  Trophy,
  Film,
  Tent,
  CalendarDays,
  Beer,
  MapPin,
  HeartHandshake,
  Sparkles,
  type LucideIcon,
} from 'lucide-react';
import { defaultLang, useTranslations, type Locale } from '@/i18n/ui';

const lang: Locale = (Astro.currentLocale as Locale) ?? defaultLang;
const t = useTranslations(lang);

const [events, categories] = await Promise.all([getActiviteiten(lang), getEventCategories(lang)]);

/** Curated lucide icons editors can pick for a category (mirrors the dashboard list). */
const categoryIcons: Record<string, LucideIcon> = {
  PartyPopper,
  Music,
  Trophy,
  Film,
  Tent,
  CalendarDays,
  Beer,
  MapPin,
  HeartHandshake,
  Sparkles,
};
const getCategoryIcon = (name?: string): LucideIcon =>
  (name && categoryIcons[name]) || Sparkles;
---

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .page-hero {
    background: radial-gradient(ellipse at 50% 0%, oklch(0.627 0.265 303.9 / 0.18) 0%, transparent 70%);
  }

  .page-hero-title {
    animation: fadeInUp 0.7s ease-out both;
  }

  .page-hero-subtitle {
    animation: fadeInUp 0.7s ease-out 0.15s both;
  }

  .page-hero-line {
    animation: fadeInUp 0.7s ease-out 0.25s both;
    width: 60px;
    height: 2px;
    background: oklch(0.627 0.265 303.9 / 0.6);
    margin: 1.5rem auto 0;
    border-radius: 999px;
  }

  .membership-glow {
    background: radial-gradient(ellipse at 50% 0%, oklch(0.627 0.265 303.9 / 0.14) 0%, transparent 70%);
  }

</style>

<MainLayout title={t('activities.title')}>
  <div class="page-hero grid place-items-center pt-30 md:pt-0 min-h-[50vh] content-center">
    <div class="text-center px-6">
      <h1 class="page-hero-title text-6xl md:text-8xl text-white font-bold">{t('activities.title')}</h1>
      <h2 class="page-hero-subtitle text-base sm:text-xl lg:text-2xl mt-4 text-white/90 font-medium max-w-3xl">
        {t('activities.subtitle')}
      </h2>
      <div class="page-hero-line"></div>
    </div>
  </div>

  <ContextLayout>
    <div class="mx-auto px-6 sm:px-8 py-12 w-full">
      <SectionHeader
        title={t('activities.whatTitle')}
        description={t('activities.whatDescription')}
      />

      {categories.length > 0 && (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map((cat) => (
            (() => {
              const Icon = getCategoryIcon(cat.icon)
              return (
                <IconCard
                  icon={Icon}
                  title={cat.name}
                  description={cat.description ?? ''}
                  variant="subtle"
                />
              )
            })()
          ))}
        </div>
      )}

      <Spacer />

      <SectionHeader
        title={t('activities.upcomingTitle')}
        description={t('activities.upcomingDescription')}
      />

      <EventGrid events={events} />

      <Spacer />

      <SectionHeader
        title={t('activities.howTitle')}
        description={t('activities.howDescription')}
      />

      <div class="grid gap-6 md:grid-cols-3">
        <div class="bg-card border border-zinc-800 rounded-xl p-6 text-center">
          <div class="text-4xl font-bold text-purple-400 mb-2">1</div>
          <h3 class="text-lg font-bold text-white mb-2">{t('activities.step1Title')}</h3>
          <p class="text-zinc-400 text-sm">{t('activities.step1Desc')}</p>
        </div>
        <div class="bg-card border border-zinc-800 rounded-xl p-6 text-center">
          <div class="text-4xl font-bold text-purple-400 mb-2">2</div>
          <h3 class="text-lg font-bold text-white mb-2">{t('activities.step2Title')}</h3>
          <p class="text-zinc-400 text-sm">{t('activities.step2Desc')}</p>
        </div>
        <div class="bg-card border border-zinc-800 rounded-xl p-6 text-center">
          <div class="text-4xl font-bold text-purple-400 mb-2">3</div>
          <h3 class="text-lg font-bold text-white mb-2">{t('activities.step3Title')}</h3>
          <p class="text-zinc-400 text-sm">{t('activities.step3Desc')}</p>
        </div>
      </div>

      <Spacer variant="dubble" />

      <div class="membership-glow rounded-3xl border border-zinc-800 bg-zinc-900/50 p-8 md:p-16 text-center">
        <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tight mb-4">
          {t('activities.readyTitle')}
        </h2>
        <p class="text-zinc-400 max-w-2xl mx-auto mb-8 text-base md:text-lg">
          {t('activities.readyDesc')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="https://docs.google.com/forms/d/e/1FAIpQLSdaEL-QgBllK1SMC0Ckwrr98dDxFbch5TijesD71YsS8t5g4g/viewform?usp=sharing&ouid=100528290258116040611">
            <Button variant="default" className="w-full sm:w-auto p-6 text-xl">{t('activities.joinCta')}</Button>
          </a>
          <a href="https://www.facebook.com/fenrir.antwerpen" target="_blank" rel="noopener">
            <Button variant="outline" className="w-full sm:w-auto p-6 text-xl border-zinc-700 text-white hover:bg-zinc-800 hover:text-white">
              {t('activities.facebookCta')}
            </Button>
          </a>
        </div>
      </div>
    </div>
  </ContextLayout>
</MainLayout>
