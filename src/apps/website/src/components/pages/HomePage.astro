---
import { Button } from '@/components/ui/button';
import MainLayout from '@/layouts/main.astro';
import ContextLayout from '@/layouts/context.astro'
import SponsorList from '@/components/SponsorList';
import SponsorImageGrid from '@/components/SponsorImageGrid';
import SectionHeader from '@/components/ui/sectionHeader';
import PreasidiumPrevieuwHomePage from '@/components/PreasidiumPrevieuwHomePage';
import Spacer from '@/components/ui/spacer';
import { IconCard } from '@/components/IconCard';
import { getSponsors, getOpeningWeekSponsors, getPreasidiumYears, getActiviteiten, getHeroImage } from '@/lib/pocketbase';
import { Users, Calendar, MapPin, HeartHandshake, ArrowRight } from 'lucide-react';
import EventGrid from '@/components/EventGrid.astro';
import { defaultLang, useTranslations, partnerAdjectives, type Locale } from '@/i18n/ui';
import { useTranslatedPath } from '@/i18n/utils';

const lang: Locale = (Astro.currentLocale as Locale) ?? defaultLang;
const translatedPath = useTranslatedPath(lang);
const t = useTranslations(lang);

const [sponsors, openingWeekSponsors, years, events, heroImage] = await Promise.all([
    getSponsors(lang),
    getOpeningWeekSponsors(lang),
    getPreasidiumYears(lang),
    getActiviteiten(lang),
    getHeroImage(),
]);
const previewLeden = years[0]?.PreasidiumLeden.slice(0, 2) ?? [];
const previewEvents = events.slice(0, 3);
---
<style>
	/* Brand-consistent overlay: primary-tinted vignette into the page
	   background (the old hard-coded rgba/oklch values bypassed the tokens). */
	.hero {
		background:
			linear-gradient(rgba(93, 63, 211, 0.55), oklch(from var(--background) l a h / 0.92) 85%),
			url('../../images/hero.jpg') center/cover no-repeat;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-title {
		opacity: 0;
		animation: fadeInUp 0.7s ease-out forwards;
	}

	.hero-subtitle {
		opacity: 0;
		animation: fadeInUp 0.7s ease-out 0.15s forwards;
	}

	.hero-cta {
		opacity: 0;
		animation: fadeInUp 0.7s ease-out 0.3s forwards;
	}

	@keyframes heroBtnShake {
		/* shake happens in the first ~15%, rest is a pause */
		0%        { transform: rotate(0deg); }
		2%        { transform: rotate(-4deg); }
		4%        { transform: rotate(4deg); }
		6%        { transform: rotate(-3deg); }
		8%        { transform: rotate(3deg); }
		10%       { transform: rotate(-1deg); }
		12%       { transform: rotate(1deg); }
		14%, 100% { transform: rotate(0deg); }
	}

	.hero-btn {
		transition: transform 0.18s ease, box-shadow 0.18s ease !important;
		animation: heroBtnShake 4s ease-in-out 1.8s infinite;
	}

	.hero-btn:hover {
		transform: translateY(-3px) scale(1.04);
		box-shadow: 0 8px 32px oklch(0.627 0.265 303.9 / 0.55);
		animation-play-state: paused;
	}

	.hero-btn:active {
		transform: translateY(0) scale(0.97);
		box-shadow: 0 2px 8px oklch(0.627 0.265 303.9 / 0.3);
	}

	/* Scroll cue: gentle bounce invites the scroll; reduced-motion users get a
	   static chevron (the global reduce rule also handles transitions). */
	@keyframes scrollCue {
		0%, 100% { transform: translateY(0); opacity: 0.7; }
		50%      { transform: translateY(6px); opacity: 1; }
	}

	.hero-scroll {
		animation: scrollCue 1.8s ease-in-out infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-title,
		.hero-subtitle,
		.hero-cta {
			opacity: 1; /* don't leave content invisible when animations are killed */
			animation: none;
		}
		.hero-btn {
			animation: none;
		}
		.hero-scroll {
			animation: none;
		}
	}
</style>
<MainLayout title={`Fenrir Antwerpen`}>
		<div class="relative grid place-items-center h-svh content-center hero" style={heroImage ? `background-image: linear-gradient(rgba(93,63,211,0.55), oklch(from var(--background) l a h / 0.92) 85%), url('${heroImage}')` : undefined}>
			<h1 class="hero-title text-5xl sm:text-6xl lg:text-7xl text-white font-bold tracking-tight">Fenrir Antwerpen</h1>
			<h2 class="hero-subtitle text-lg sm:text-2xl lg:text-3xl mt-5 max-w-2xl text-balance text-white/90 font-medium">{t('home.heroSubtitle')}</h2>
			<span class="hero-cta flex flex-col sm:flex-row w-3/6 sm:w-max gap-3 sm:gap-4 mt-6">
				<a href="https://form.fenrirclub.be/lidworden"><Button variant="default" className='hero-btn w-full sm:w-auto px-8 py-5 text-lg lg:text-xl'>{t('home.joinCta')}</Button></a>
				<a href={translatedPath('activiteiten')}><Button variant="secondary" className='w-full sm:w-auto px-8 py-5 text-lg lg:text-xl'>{t('home.activitiesCta')}</Button></a>
			</span>
			<a
				href="#welcomesection"
				aria-label={t('home.welcomeTitle')}
				class="hero-scroll absolute bottom-8 grid size-10 place-items-center rounded-full border border-white/15 bg-white/5 text-white/80 backdrop-blur-sm transition-colors hover:bg-white/10 hover:text-white"
			>
				<svg xmlns="http://www.w3.org/2000/svg" class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
			</a>
		</div>
		<ContextLayout>
<div class="mx-auto px-6 sm:px-8 py-10">
    <div class="flex flex-col md:flex-row md:items-stretch gap-6" id="welcomesection">

        <img
            src="../../images/schild.png"
            alt="Fenrir schild"
            class="
                h-40 md:h-full
                w-auto
                object-contain
                shrink-0
                self-center md:self-auto
            "
        >

			<div class="flex content-center place-items-center">
      			<div class="text-center md:text-left">
				<h1 class="font-bold text-4xl mb-4 text-accent">{t('home.welcomeTitle')}</h1>
				<h2 class="font-medium text-2xl mb-4">{t('home.welcomeSubtitle')}</h2>
				<!-- Measure cap: the container spans ~1150px, so uncapped paragraphs
				     produced 100+ char lines on desktop. -->
				<p class="mb-4 max-w-prose mx-auto md:mx-0 text-muted-foreground leading-relaxed">{t('home.welcomeP1')}</p>
				<p class="mb-4 max-w-prose mx-auto md:mx-0 text-muted-foreground leading-relaxed">{t('home.welcomeP2')}</p>
					<p class="mb-4 max-w-prose mx-auto md:mx-0 text-muted-foreground leading-relaxed">{t('home.welcomeP3')}</p>
				</div>
			</div>
			</div>

	<Spacer/>

	<SectionHeader title={t('home.whyTitle')} description={t('home.whyDescription')}/>

	<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-8">
		<IconCard
			icon={Users}
			title={t('home.why1Title')}
			description={t('home.why1Desc')}
			variant="subtle"
		/>
		<IconCard
			icon={Calendar}
			title={t('home.why2Title')}
			description={t('home.why2Desc')}
			variant="subtle"
		/>
		<IconCard
			icon={MapPin}
			title={t('home.why3Title')}
			description={t('home.why3Desc')}
			variant="subtle"
		/>
		<IconCard
			icon={HeartHandshake}
			title={t('home.why4Title')}
			description={t('home.why4Desc')}
			variant="subtle"
		/>
	</div>

	{
		previewEvents.length > 0 && (
			<>
				<Spacer/>

				<SectionHeader title={t('home.activitiesTitle')} description={t('home.activitiesDescription')}/>

				<EventGrid events={previewEvents} />

				<div class="mt-10 flex justify-center">
					<a href={translatedPath('activiteiten')}>
						<Button variant="outline" className="border-border text-foreground hover:bg-accent/10 hover:text-foreground">
							{t('home.activitiesViewAll')}
							<ArrowRight class="size-4" />
						</Button>
					</a>
				</div>
			</>
		)
	}

	<Spacer/>

	<SectionHeader title={t('home.praesidiumTitle')} description={t('home.praesidiumDescription')}/>
	<div>
		<PreasidiumPrevieuwHomePage
			leden={previewLeden}
			ctaHref={lang === 'nl' ? '/praesidium' : '/en/praesidium'}
			ctaTitle={t('home.praesidiumCtaTitle')}
			ctaDescription={t('home.praesidiumCtaDescription')}
			moreText={t('common.more')}
			noDescriptionText={t('preasidiumLid.noDescription')}
			detailedInfoTemplate={t('preasidiumLid.detailedInfo')}
			client:load
		/>
	</div>
	<Spacer/>

	{
		openingWeekSponsors.length > 0 && (
			<>
				<SectionHeader title={t('sponsors.openingWeekTitle')}/>
				<div class="w-full">
					<SponsorImageGrid data={openingWeekSponsors} client:load/>
				</div>
				<Spacer/>
			</>
		)
	}

    <SectionHeader title={t('home.sponsorsTitle')} description={t('home.sponsorsDescription')}/>
    <div class="w-full">
        <SponsorList data={sponsors} partnerLabel={t('sponsors.partnerLabel')} partnerAdjectives={partnerAdjectives[lang]} client:load/>
    </div>

		</ContextLayout>
</MainLayout>
