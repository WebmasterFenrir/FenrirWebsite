---
import MainLayout from '@/layouts/main.astro';
import ContextLayout from '@/layouts/context.astro';
import SectionHeader from '@/components/ui/sectionHeader';
import Spacer from '@/components/ui/spacer';
import { Fragment } from 'astro/jsx-runtime';
import { defaultLang, useTranslations, type Locale } from '@/i18n/ui';

const lang: Locale = (Astro.currentLocale as Locale) ?? defaultLang;
const t = useTranslations(lang);

const strofeLines = ['about.strofeL1', 'about.strofeL2', 'about.strofeL3', 'about.strofeL4'] as const;
const keerzangLines = ['about.keerzangL1', 'about.keerzangL2', 'about.keerzangL3', 'about.keerzangL4'] as const;
---

<style>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .page-hero {
    background: radial-gradient(ellipse at 50% 0%, oklch(0.627 0.265 303.9 / 0.18) 0%, transparent 70%);
  }

  .page-hero-title {
    animation: fadeInUp 0.7s ease-out both;
  }

  .page-hero-subtitle {
    animation: fadeInUp 0.7s ease-out 0.15s both;
  }

  .page-hero-line {
    animation: fadeInUp 0.7s ease-out 0.25s both;
    width: 60px;
    height: 2px;
    background: oklch(0.627 0.265 303.9 / 0.6);
    margin: 1.5rem auto 0;
    border-radius: 999px;
  }
</style>
<MainLayout title={t('about.title')}>

  <div class="page-hero grid place-items-center pt-30 md:pt-0 min-h-[50vh] content-center">
    <div class="text-center px-6">
      <h1 class="page-hero-title text-6xl md:text-8xl text-white font-bold">{t('about.heading')}</h1>
      <h2 class="page-hero-subtitle text-base sm:text-xl lg:text-2xl mt-4 text-white/90 font-medium max-w-3xl">
        {t('about.subtitle')}
      </h2>
      <div class="page-hero-line"></div>
    </div>
  </div>
  <ContextLayout>
    <div class="mx-auto px-6 sm:px-8 py-12 w-full">
      <SectionHeader
        title={t('about.historyTitle')}
        description={t('about.historyDescription')}
      />
      <div class="grid gap-6 text-zinc-200">
        <p>
          {t('about.historyP1').split('\n').map((line, i, arr) => (
            <Fragment>
              {line}
              {i < arr.length - 1 && <br />}
            </Fragment>
          ))}
        </p>
      </div>

      <Spacer />
      <h2 class="text-4xl sm:text-4xl lg:text-4xl text-accent-foreground font-bold mb-4 mt-8">{t('about.antwerpenTitle')}</h2>
      <div class="grid gap-6 text-zinc-200">
        <p>
          {t('about.antwerpenP1')}
        </p>
        <p>
          {t('about.antwerpenP2')}
        </p>
        <p>
          {t('about.antwerpenP3')}
        </p>
      </div>

      <Spacer />
      <h2 class="text-4xl sm:text-4xl lg:text-4xl text-accent-foreground font-bold mb-4 mt-8">{t('about.bruggeTitle')}</h2>
      <div class="grid gap-6 text-zinc-200">
        <p>
          {t('about.bruggeP1')}
        </p>
        <p>
          {t('about.bruggeP2')}
        </p>
        <p>
          {t('about.bruggeP3')}
        </p>
        <p>
          {t('about.bruggeP4')}
        </p>
      </div>

      <Spacer />
      <SectionHeader
        title={t('about.nameTitle')}
        description={t('about.nameDescription')}
      />
      <div class="grid gap-6 text-zinc-200">
        <p>
          {t('about.nameP1')}
        </p>
        <p>
          {t('about.nameP2')}
        </p>
        <p>
          {t('about.nameP3')}
        </p>
        <p>
          {t('about.nameP4')}
        </p>
      </div>

      <Spacer />
      <SectionHeader
        title={t('about.clubSongTitle')}
        description={t('about.clubSongDescription')}
      />
      <div class="grid gap-4 text-zinc-200">
        <p>
          {t('about.clubSongP1')}
        </p>
        <p>
          {t('about.clubSongP2')}{' '}
          <a class="underline hover:no-underline" href="https://www.youtube.com/watch?v=Q9qN88UU7aU" target="_blank" rel="noopener">De Blauwvoet</a>.
        </p>
        <div class="grid gap-4 md:gap-6 md:grid-cols-2">
          <div class="bg-card border border-accent-foreground rounded-lg p-4 md:p-6">
            <div class="flex items-center gap-2 text-[11px] tracking-wide uppercase text-accent-foreground">
              <span class="inline-block h-3 w-1 rounded-sm bg-accent-foreground"></span>
              {t('about.strofe')}
            </div>
            <div class="mt-3 space-y-1 leading-relaxed">
              {strofeLines.map((key) => (
                <p>{t(key)}</p>
              ))}
            </div>
          </div>
          <div class="bg-card border border-accent rounded-lg p-4 md:p-6">
            <div class="flex items-center gap-2 text-[11px] tracking-wide uppercase text-accent">
              <span class="inline-block h-3 w-1 rounded-sm bg-accent"></span>
              {t('about.keerzang')}
            </div>
            <div class="mt-3 space-y-1 leading-relaxed">
              {keerzangLines.map((key) => (
                <p>{t(key)}</p>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </ContextLayout>
</MainLayout>
