# Copy to .env (same folder) and fill in the values. .env is gitignored.
# This file is loaded by ./start.sh for local pocketbase.exe runs (no Docker).

# ── DeepL auto-translation (pb_hooks/translate.pb.js) ───────────────────────
DEEPL_API_KEY=

# ── GitHub issue hook (pb_hooks/forms.pb.js, hook "bugticket") ──────────────
# A fine-grained PAT with "Issues: Read and write" on WebmasterFenrir/
# FenrirWebsite (or a classic PAT with the issues scope).
GITHUB_TOKEN=
GITHUB_REPO=WebmasterFenrir/FenrirWebsite
